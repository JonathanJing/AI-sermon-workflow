# Google Cloud Configuration
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GOOGLE_CLOUD_PROJECT=ai-for-god
GCS_BUCKET_NAME=ai-sermon-workflow

# Application Configuration
APP_NAME=sermon-workflow
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# Storage Configuration
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./data/processed
MAX_FILE_SIZE_MB=500
MAX_PROCESSING_TIME_SECONDS=3600

# Speech-to-Text Configuration
STT_LANGUAGE_CODE=cmn-Hans-CN
STT_MODEL=default
STT_ENABLE_WORD_TIME_OFFSETS=true
STT_ENABLE_AUTOMATIC_PUNCTUATION=true
STT_COST_LIMIT_USD=10.0

# Subtitle Configuration
SUBTITLE_MAX_LINE_LENGTH=42
SUBTITLE_MAX_LINES=2

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=

# Database Configuration
DATABASE_URL=sqlite:///./sermon_workflow.db

# Development Configuration
RELOAD=true
